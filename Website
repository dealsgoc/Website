    <script>
        // Configuration
        const ajaxUrl = '<?php echo get_permalink(); ?>?action=mdg_ajax';
        
        // State management
        const bookingState = {
            corp: {
                currentStep: 1,
                service: null,
                date: null,
                time: null,
                availableDates: []
            },
            priv: {
                currentStep: 1,
                service: null,
                date: null,
                time: null,
                availableDates: []
            }
        };
        
        // Modal Functions
        function openModal(type) {
            const modal = document.getElementById(type + 'Modal');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // Reset form when opening
            resetBookingForm(type === 'corporate' ? 'corp' : 'priv');
        }
        
        function closeModal(type) {
            const modal = document.getElementById(type + 'Modal');
            modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }
        
        // Reset booking form
        function resetBookingForm(prefix) {
            bookingState[prefix] = {
                currentStep: 1,
                service: null,
                date: null,
                time: null,
                availableDates: []
            };
            
            // Reset UI
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`${prefix}-step-${i}`).classList.toggle('active', i === 1);
                document.getElementById(`${prefix}-progress-${i}`).classList.remove('active', 'completed');
            }
            document.getElementById(`${prefix}-progress-1`).classList.add('active');
            
            document.getElementById(`${prefix}-back-btn`).style.display = 'none';
            document.getElementById(`${prefix}-next-btn`).style.display = 'block';
            document.getElementById(`${prefix}-submit-btn`).style.display = 'none';
            
            // Clear form
            document.getElementById(prefix === 'corp' ? 'corporateBookingForm' : 'privateBookingForm').reset();
        }
        
        // Step navigation
        function nextStep(prefix) {
            const currentStep = bookingState[prefix].currentStep;
            
            // Validate current step
            if (!validateStep(prefix, currentStep)) {
                return;
            }
            
            // Move to next step
            if (currentStep < 4) {
                showStep(prefix, currentStep + 1);
                
                // Load data for next step
                if (currentStep === 1) {
                    loadAvailableDates(prefix);
                } else if (currentStep === 2) {
                    loadTimeSlots(prefix);
                }
            }
        }
        
        function previousStep(prefix) {
            const currentStep = bookingState[prefix].currentStep;
            if (currentStep > 1) {
                showStep(prefix, currentStep - 1);
            }
        }
        
        function showStep(prefix, step) {
            bookingState[prefix].currentStep = step;
            
            // Update steps visibility
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`${prefix}-step-${i}`).classList.toggle('active', i === step);
                
                // Update progress indicators
                const progressStep = document.getElementById(`${prefix}-progress-${i}`);
                progressStep.classList.toggle('active', i === step);
                progressStep.classList.toggle('completed', i < step);
            }
            
            // Update buttons
            document.getElementById(`${prefix}-back-btn`).style.display = step === 1 ? 'none' : 'block';
            document.getElementById(`${prefix}-next-btn`).style.display = step === 4 ? 'none' : 'block';
            document.getElementById(`${prefix}-submit-btn`).style.display = step === 4 ? 'block' : 'none';
        }
        
        function validateStep(prefix, step) {
            const formPrefix = prefix === 'corp' ? 'corporate' : 'private';
            const form = document.getElementById(formPrefix + 'BookingForm');
            
            switch(step) {
                case 1:
                    const service = form.querySelector('input[name="service"]:checked');
                    if (!service) {
                        alert('Please select a service');
                        return false;
                    }
                    bookingState[prefix].service = service.value;
                    return true;
                    
                case 2:
                    if (!bookingState[prefix].date) {
                        alert('Please select a date');
                        return false;
                    }
                    return true;
                    
                case 3:
                    if (!bookingState[prefix].time) {
                        alert('Please select a time');
                        return false;
                    }
                    return true;
                    
                default:
                    return true;
            }
        }
        
        // Load available dates
        function loadAvailableDates(prefix) {
            const serviceId = bookingState[prefix].service;
            console.log('Loading dates for service:', serviceId);
            
            // Show loading state
            document.getElementById(`${prefix}-month-year`).textContent = 'Loading...';
            document.getElementById(`${prefix}-calendar`).innerHTML = '<div style="text-align:center; padding: 20px;">Loading available dates...</div>';
            
            jQuery.post(ajaxUrl, {
                request_type: 'get_dates',
                service_id: serviceId
            }, function(response) {
                console.log('Date response:', response);
                
                if (response.success && response.dates) {
                    bookingState[prefix].availableDates = response.dates;
                    renderCalendar(prefix);
                } else {
                    // Show error message
                    document.getElementById(`${prefix}-calendar`).innerHTML = 
                        '<div style="text-align:center; padding: 20px; color: var(--gold);">' +
                        'Error loading dates: ' + (response.message || 'Unknown error') + 
                        '<br><br><button onclick="loadAvailableDates(\'' + prefix + '\')" class="btn btn-secondary">Retry</button>' +
                        '</div>';
                    
                    if (response.debug) {
                        console.error('Debug info:', response.debug);
                    }
                }
            }).fail(function(jqXHR, textStatus, errorThrown) {
                console.error('AJAX error:', textStatus, errorThrown);
                document.getElementById(`${prefix}-calendar`).innerHTML = 
                    '<div style="text-align:center; padding: 20px; color: var(--gold);">' +
                    'Connection error. Please check your internet connection and try again.' +
                    '<br><br><button onclick="loadAvailableDates(\'' + prefix + '\')" class="btn btn-secondary">Retry</button>' +
                    '</div>';
            });
        }
        
        // Render calendar
        function renderCalendar(prefix) {
            const now = new Date();
            const year = now.getFullYear();
            const month = now.getMonth();
            
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                              'July', 'August', 'September', 'October', 'November', 'December'];
            
            document.getElementById(`${prefix}-month-year`).textContent = `${monthNames[month]} ${year}`;
            
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            
            let calendarHTML = '';
            
            // Day labels
            const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            dayLabels.forEach(day => {
                calendarHTML += `<div class="day-label">${day}</div>`;
            });
            
            // Empty cells for days before month starts
            for (let i = 0; i < firstDay; i++) {
                calendarHTML += '<div class="calendar-day unavailable"></div>';
            }
            
            // Days of the month
            for (let day = 1; day <= daysInMonth; day++) {
                const date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isAvailable = bookingState[prefix].availableDates[date] === true;
                const isPast = new Date(date) < new Date().setHours(0,0,0,0);
                
                if (isAvailable && !isPast) {
                    calendarHTML += `<div class="calendar-day available" onclick="selectDate('${prefix}', '${date}')">${day}</div>`;
                } else {
                    calendarHTML += `<div class="calendar-day unavailable">${day}</div>`;
                }
            }
            
            document.getElementById(`${prefix}-calendar`).innerHTML = calendarHTML;
        }
        
        function changeMonth(prefix, direction) {
            // This is a simplified version - you'd need to track current month/year
            // and update accordingly
            console.log('Change month:', direction);
        }
        
        function selectDate(prefix, date) {
            // Update UI
            document.querySelectorAll(`#${prefix}-calendar .calendar-day`).forEach(day => {
                day.classList.remove('selected');
            });
            event.target.classList.add('selected');
            
            // Update state
            bookingState[prefix].date = date;
            document.getElementById(`${prefix}-selected-date`).value = date;
        }
        
        // Load time slots
        function loadTimeSlots(prefix) {
            const serviceId = bookingState[prefix].service;
            const date = bookingState[prefix].date;
            
            // Show loading
            document.getElementById(`${prefix}-time-loading`).classList.add('active');
            document.getElementById(`${prefix}-time-slots`).innerHTML = '';
            
            jQuery.post(ajaxUrl, {
                request_type: 'get_times',
                service_id: serviceId,
                date: date
            }, function(response) {
                document.getElementById(`${prefix}-time-loading`).classList.remove('active');
                
                if (response.success && response.times) {
                    renderTimeSlots(prefix, response.times);
                }
            });
        }
        
        function renderTimeSlots(prefix, times) {
            let slotsHTML = '';
            
            times.forEach(time => {
                const formattedTime = formatTime(time);
                slotsHTML += `
                    <label class="time-slot">
                        <input type="radio" name="time_slot" value="${time}" onchange="selectTime('${prefix}', '${time}')">
                        <span>${formattedTime}</span>
                    </label>
                `;
            });
            
            if (times.length === 0) {
                slotsHTML = '<p style="grid-column: 1/-1; text-align: center; color: var(--text-light);">No available times for this date. Please select another date.</p>';
            }
            
            document.getElementById(`${prefix}-time-slots`).innerHTML = slotsHTML;
        }
        
        function selectTime(prefix, time) {
            bookingState[prefix].time = time;
            document.getElementById(`${prefix}-selected-time`).value = time;
            
            // Update UI
            document.querySelectorAll(`#${prefix}-time-slots .time-slot`).forEach(slot => {
                slot.classList.remove('selected');
            });
            event.target.closest('.time-slot').classList.add('selected');
        }
        
        function formatTime(time) {
            const [hours, minutes] = time.split(':');
            const hour = parseInt(hours);
            const ampm = hour >= 12 ? 'PM' : 'AM';
            const displayHour = hour % 12 || 12;
            return `${displayHour}:${minutes} ${ampm}`;
        }
        
        // Form submission
        document.getElementById('corporateBookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            submitBooking('corp');
        });
        
        document.getElementById('privateBookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            submitBooking('priv');
        });
        
        function submitBooking(prefix) {
            const formPrefix = prefix === 'corp' ? 'corporate' : 'private';
            const form = document.getElementById(formPrefix + 'BookingForm');
            const formData = new FormData(form);
            
            // Show loading
            document.getElementById(`${prefix}-form-loading`).classList.add('active');
            form.style.display = 'none';
            
            // Add booking data
            formData.append('request_type', 'create_booking');
            formData.append('service_id', bookingState[prefix].service);
            formData.append('date', bookingState[prefix].date);
            formData.append('time', bookingState[prefix].time);
            
            jQuery.ajax({
                url: ajaxUrl,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    document.getElementById(`${prefix}-form-loading`).classList.remove('active');
                    
                    if (response.success) {
                        // Show success message
                        document.getElementById(`${prefix}-success`).style.display = 'block';
                        
                        if (response.payment_required && response.payment_url) {
                            document.getElementById(`${prefix}-payment-message`).style.display = 'block';
                            // Optionally redirect to payment
                            setTimeout(() => {
                                window.open(response.payment_url, '_blank');
                            }, 2000);
                        }
                    } else {
                        alert('There was an error processing your booking. Please try again.');
                        form.style.display = 'block';
                    }
                },
                error: function() {
                    document.getElementById(`${prefix}-form-loading`).classList.remove('active');
                    form.style.display = 'block';
                    alert('There was an error processing your booking. Please try again.');
                }
            });
        }
        
        // Service option selection
        document.querySelectorAll('.service-option').forEach(option => {
            option.addEventListener('click', function() {
                this.closest('.service-grid').querySelectorAll('.service-option').forEach(opt => {
                    opt.classList.remove('selected');
                });
                this.classList.add('selected');
                this.querySelector('input[type="radio"]').checked = true;
            });
        });
        
        // Urgency option selection
        document.querySelectorAll('.urgency-option').forEach(option => {
            option.addEventListener('click', function() {
                this.closest('.urgency-options').querySelectorAll('.urgency-option').forEach(opt => {
                    opt.classList.remove('selected');
                });
                this.classList.add('selected');
                this.querySelector('input[type="radio"]').checked = true;
            });
        });
        
        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }
        
        // Add smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
        
        // Add parallax effect to hero
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const hero = document.querySelector('.hero');
            hero.style.transform = `translateY(${scrolled * 0.5}px)`;
        });
        
        // Animate elements on scroll
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fadeInUp 1s ease forwards';
                }
            });
        }, observerOptions);
        
        document.querySelectorAll('.pain-card, .testimonial').forEach(el => {
            observer.observe(el);
        });
    </script>
