// SimplyBook.me API Integration Class
class SimplybookAPI {
    private $company_login = 'mdgnotaryca';
    // Using the token directly since it's already authenticated
    private $token = '3ce5e34c1a42959c9c61f4ffb2f3e4a7f473b717e41cfe10c31702f24ecd0242';
    private $api_url = 'https://user-api.simplybook.me/';
    private $unit_id = 2; // Giuliano Helguero
    
    public function __construct() {
        // Token is already set, no need to authenticate
    }
    
    private function makeRequest($url, $data, $use_token = true) {
        $ch = curl_init();
        
        // Correct endpoint URL
        if ($use_token && $this->token) {
            $url = 'https://user-api-v2.simplybook.me/admin/';
        }
        
        $headers = [
            'Content-Type: application/json',
            'X-Company-Login: ' . $this->company_login,
            'X-Token: ' . $this->token
        ];
        
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        
        $response = curl_exec($ch);
        $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        
        if (curl_errno($ch)) {
            error_log('CURL Error: ' . curl_error($ch));
            return false;
        }
        
        curl_close($ch);
        
        $result = json_decode($response, true);
        
        // Debug logging
        error_log('API Request to: ' . $url);
        error_log('API Response Code: ' . $http_code);
        error_log('API Response: ' . substr($response, 0, 500));
        
        return $result;
    }
    
    public function getAvailableDates($event_id, $date_from = null, $date_to = null) {
        if (!$date_from) {
            $date_from = date('Y-m-d');
        }
        if (!$date_to) {
            $date_to = date('Y-m-d', strtotime('+30 days'));
        }
        
        $request = [
            'jsonrpc' => '2.0',
            'method' => 'getWorkDaysInfo',
            'params' => [
                $date_from,     // from date
                $date_to,       // to date
                intval($this->unit_id),  // unit_id as integer
                intval($event_id),       // event_id as integer
                1               // count
            ],
            'id' => 1
        ];
        
        $result = $this->makeRequest(null, $request, true);
        
        // Return the result array directly
        return $result;
    }
    
    public function getAvailableTimeSlots($event_id, $date) {
        $request = [
            'jsonrpc' => '2.0',
            'method' => 'getStartTimeMatrix',
            'params' => [
                $date,
                $date,
                $event_id,
                $this->unit_id,
                1
            ],
            'id' => 1
        ];
        
        return $this->makeRequest(null, $request);
    }
    
    public function createBooking($event_id, $date, $time, $client_data, $additional = []) {
        $client = $this->addClient($client_data);
        
        if (!$client) {
            return false;
        }
        
        $request = [
            'jsonrpc' => '2.0',
            'method' => 'book',
            'params' => [
                $event_id,
                $this->unit_id,
                $date,
                $time,
                [
                    'id' => $client['id'],
                    'name' => $client_data['name'],
                    'email' => $client_data['email'],
                    'phone' => $client_data['phone']
                ],
                $additional,
                1
            ],
            'id' => 1
        ];
        
        return $this->makeRequest(null, $request);
    }
    
    public function addClient($client_data) {
        $request = [
            'jsonrpc' => '2.0',
            'method' => 'addClient',
            'params' => [
                [
                    'name' => $client_data['name'],
                    'email' => $client_data['email'],
                    'phone' => $client_data['phone']
                ]
            ],
            'id' => 1
        ];
        
        $response = $this->makeRequest(null, $request);
        return isset($response['result']) ? $response['result'] : false;
    }
    
    public function getPaymentInfo($booking_id) {
        $request = [
            'jsonrpc' => '2.0',
            'method' => 'getBookingCartPaymentPageUrl',
            'params' => [
                $booking_id
            ],
            'id' => 1
        ];
        
        return $this->makeRequest(null, $request);
    }
}

// Handle AJAX requests
if (isset($_GET['action']) && $_GET['action'] === 'mdg_ajax') {
    header('Content-Type: application/json');
    
    $api = new SimplybookAPI();
    $response = ['success' => false, 'message' => ''];
    
    try {
        if ($_POST['request_type'] === 'get_dates') {
            $service_id = intval($_POST['service_id']);
            
            // Test API connection first
            $test_request = [
                'jsonrpc' => '2.0',
                'method' => 'getCompanyInfo',
                'params' => [],
                'id' => 1
            ];
            
            // Try to get company info to test connection
            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, 'https://user-api-v2.simplybook.me/admin/');
            curl_setopt($ch, CURLOPT_HTTPHEADER, [
                'Content-Type: application/json',
                'X-Company-Login: mdgnotaryca',
                'X-Token: 3ce5e34c1a42959c9c61f4ffb2f3e4a7f473b717e41cfe10c31702f24ecd0242'
            ]);
            curl_setopt($ch, CURLOPT_POST, true);
            curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($test_request));
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            
            $test_response = curl_exec($ch);
            $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            
            if ($http_code !== 200) {
                $response['message'] = 'API Connection failed. HTTP Code: ' . $http_code;
                $response['debug'] = $test_response;
            } else {
                // Now get the actual dates
                $result = $api->getAvailableDates($service_id);
                
                if ($result && isset($result['result'])) {
                    $response = [
                        'success' => true, 
                        'dates' => $result['result'],
                        'message' => 'Dates loaded successfully'
                    ];
                } else {
                    $response['message'] = 'No dates available for this service';
                    $response['debug'] = json_encode($result);
                }
            }
        }
        
        if ($_POST['request_type'] === 'get_times') {
            $service_id = intval($_POST['service_id']);
            $date = $_POST['date'];
            
            $result = $api->getAvailableTimeSlots($service_id, $date);
            if ($result && isset($result['result'])) {
                $response = [
                    'success' => true, 
                    'times' => $result['result'][$date] ?? [],
                    'message' => 'Times loaded successfully'
                ];
            } else {
                $response['message'] = 'No times available for this date';
            }
        }
        
        if ($_POST['request_type'] === 'create_booking') {
            $client_data = [
                'name' => sanitize_text_field($_POST['name']),
                'email' => sanitize_email($_POST['email']),
                'phone' => sanitize_text_field($_POST['phone'])
            ];
            
            $additional = [];
            if (!empty($_POST['company'])) {
                $additional[] = ['id' => 1, 'value' => sanitize_text_field($_POST['company'])];
            }
            if (!empty($_POST['notes'])) {
                $additional[] = ['id' => 2, 'value' => sanitize_text_field($_POST['notes'])];
            }
            if (!empty($_POST['urgency'])) {
                $additional[] = ['id' => 3, 'value' => sanitize_text_field($_POST['urgency'])];
            }
            
            $result = $api->createBooking(
                intval($_POST['service_id']),
                $_POST['date'],
                $_POST['time'],
                $client_data,
                $additional
            );
            
            if ($result && isset($result['result'])) {
                $booking_data = $result['result'];
                $payment_url = '';
                
                if ($booking_data['require_payment']) {
                    $payment_info = $api->getPaymentInfo($booking_data['bookings'][0]);
                    if ($payment_info && isset($payment_info['result'])) {
                        $payment_url = $payment_info['result'];
                    }
                }
                
                $response = [
                    'success' => true,
                    'booking_id' => $booking_data['bookings'][0],
                    'payment_required' => $booking_data['require_payment'],
                    'payment_url' => $payment_url,
                    'message' => 'Booking created successfully'
                ];
            } else {
                $response['message'] = 'Failed to create booking';
            }
        }
        
    } catch (Exception $e) {
        $response['message'] = 'Error: ' . $e->getMessage();
    }
    
    echo json_encode($response);
    exit;
}

